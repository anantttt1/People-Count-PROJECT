# ---------------------------------------------------------------
# Smart Vision AI - environment configuration
# Copy to .env and edit. NEVER commit .env.
# ---------------------------------------------------------------

# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Where uvicorn listens (run.py uses these). Keep 127.0.0.1 for local-only use.
HOST=127.0.0.1
PORT=8000

# Comma-separated list of browser origins allowed to call the API / open the WebSocket.
# Same-origin requests (frontend served by this backend) are always allowed.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Access control -------------------------------------------
# If set, the dashboard asks for this token and the API/WebSocket reject
# requests without a valid session cookie. REQUIRED when ENVIRONMENT=production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=

# Signs the session cookie. REQUIRED when ENVIRONMENT=production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# strict | lax | none  (use "none" only if the frontend is on a different site, requires HTTPS)
COOKIE_SAMESITE=strict
SESSION_TTL_HOURS=12

# --- Storage ---------------------------------------------------
# sqlite   -> local file, zero setup (default)
# supabase -> Supabase PostgreSQL via its REST API (run database/schema.sql first)
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/smartvision.db

# Server-side only. The service-role key bypasses RLS: never put it in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI model --------------------------------------------------
# Downloaded automatically by Ultralytics on first run.
YOLO_MODEL=yolo26n.pt
# Tried if YOLO_MODEL fails to load (e.g. an older ultralytics version).
YOLO_FALLBACK_MODEL=yolo11n.pt
# "" = auto (CUDA if available, else CPU). Examples: cpu, cuda:0, mps
YOLO_DEVICE=
YOLO_IMGSZ=640
# If YOLO cannot load at all, fall back to OpenCV's built-in HOG person
# detector (much less accurate; the UI shows a warning). Set false to fail instead.
ALLOW_HOG_FALLBACK=true

# --- Limits ----------------------------------------------------
MAX_CONCURRENT_SESSIONS=4
MAX_FRAME_BYTES=2000000
MAX_FRAME_DIMENSION=1920
# Seconds between stored occupancy snapshots per running session
SNAPSHOT_INTERVAL_SECONDS=30
